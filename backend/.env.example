# Copy to .env (never commit .env). All values optional unless noted.

# --- Ingest (device TCP) ---
NOTEPIN_TCP_HOST=0.0.0.0
NOTEPIN_TCP_PORT=5000
# true = only devices registered in data/devices.json with a valid key may stream
NOTEPIN_REQUIRE_AUTH=true
NOTEPIN_MAX_CONNECTIONS=8
NOTEPIN_MAX_RECORDING_SECONDS=7200
NOTEPIN_IDLE_TIMEOUT_MS=15000
# NOTEPIN_ALLOWED_IPS=1.2.3.4,5.6.7.8

# --- Dashboard / API ---
NOTEPIN_HTTP_HOST=0.0.0.0
NOTEPIN_HTTP_PORT=8080
# open | invite (default) | closed
NOTEPIN_SIGNUP=invite
# Set to true ONLY when the dashboard is served over HTTPS (reverse proxy / tailscale serve)
NOTEPIN_COOKIE_SECURE=false
NOTEPIN_SESSION_DAYS=7
# Session signing secret; auto-generated in data/ when empty
NOTEPIN_SECRET=

# --- Storage ---
NOTEPIN_DATA_DIR=./data
# Audio is NOT stored by default; only transcripts (JSON)
NOTEPIN_STORE_AUDIO=false
# 0 = keep transcripts forever
NOTEPIN_RETENTION_DAYS=0

# --- Transcription (Deepgram) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en

# --- Notes (Anthropic) ---
ANTHROPIC_API_KEY=
NOTEPIN_NOTES_MODEL=claude-sonnet-5-5
NOTEPIN_NOTES_MIN_CHARS=40